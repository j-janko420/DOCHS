APP_ENV=development
APP_NAME=DOCHS API
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO
# Generate a unique secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
DORCHS_API_TOKEN=replace-with-a-random-secret-at-least-32-characters-long
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
# Origins of the DOCHS web app allowed to call this API (no trailing slash)
ALLOWED_ORIGINS=http://localhost:5173,https://j-janko420.github.io

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=claude-opus-5-5
# Re-run a request declined by Claude's safety classifiers on Anthropic's recommended fallback model
ANTHROPIC_FALLBACKS=true

XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_DEFAULT_MODEL=grok-3

OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_DEFAULT_MODEL=gpt-4.1-mini

PROVIDER_TIMEOUT_SECONDS=45
MAX_INPUT_CHARS=30000
MAX_MESSAGES=40
